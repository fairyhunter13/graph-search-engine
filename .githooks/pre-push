#!/usr/bin/env bash
# Pre-push gate. Two blocks: public hygiene, then the knowledge/ bundle.
#
# A docs/ plan-pair gate and three bespoke bundle checks ran here until 2026-08-29. The
# six-rule ruling deleted them, with scripts/check_no_shrink.py, check_attester_contract.py
# and check_index_gloss.py. Each rule survives in the bundle skill as instruction.
#
# Skip with:  git push --no-verify
#
# Install:    git config core.hooksPath .githooks
# Uninstall:  git config --unset core.hooksPath
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# This repository is public, and a name reaches the world on push and not on commit.
# The ban list is the private names themselves, so it lives in the environment and
# never in the tree. Unset is the failing state: a gate that passes by not running
# is what let 70 occurrences across 23 files stand until 2026-09-01.
PY="$REPO_ROOT/.venv/bin/python"
[[ -x "$PY" ]] || PY="python3"
if ! "$PY" -m pytest -q "$REPO_ROOT/tests/test_hygiene.py" >/tmp/graphrag-hygiene.$$ 2>&1; then
  cat /tmp/graphrag-hygiene.$$
  rm -f /tmp/graphrag-hygiene.$$
  echo "[pre-push] x public hygiene failed - push blocked"
  echo "[pre-push]   set GRAPHRAG_NAME_BAN to the private-name list, or to 'none' for a clean clone"
  exit 1
fi
rm -f /tmp/graphrag-hygiene.$$

if [[ -d "$REPO_ROOT/knowledge" ]]; then
  if ! command -v okfrules >/dev/null 2>&1; then
    echo "[pre-push] x okfrules not installed - knowledge/ cannot be checked, and this hook is its only local gate"
    echo "[pre-push]   go install github.com/fairyhunter13/okf/cmd/okfrules@v0.6.1"
    exit 1
  fi
  # -strict, not the fleet default: TimestampsCarryAnOffset is a Strict rule, and an
  # offset-free stale_after reads as fresh forever. This bundle is new and can be born clean.
  if ! okfrules -strict check -Werror "$REPO_ROOT/knowledge"; then
    echo "[pre-push] x knowledge/ is not a conformant OKF bundle - push blocked"
    exit 1
  fi
fi

exit 0
