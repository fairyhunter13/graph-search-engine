#!/usr/bin/env bash
# Pre-push gate. Two blocks: the docs/ plan pair, and the knowledge/ bundle.
#
# Skip with:  git push --no-verify
#
# Install:    git config core.hooksPath .githooks
# Uninstall:  git config --unset core.hooksPath
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
DEV="$REPO_ROOT/docs/development-plan.md"
TST="$REPO_ROOT/docs/test-plan.md"

# The severity ratchet. While the pair is being seeded a row may name a path not yet
# written, which is a forward reference and not a mistake. Flipped to 1 on 2026-08-27,
# the day the output went empty. From here a finding can only be new drift.
PLAN_GATE_BLOCKING=1

plan_ids() {  # $1 = file, $2 = D or T
  # `T-94..T-101` is a range, and a token grep recovers only its two ends. Eight dev
  # rows use the shorthand, so every interior ID went unchecked by arm 4a.
  {
    grep -oE "\b$2-[0-9]+\.\.$2-[0-9]+" "$1" | while IFS= read -r span; do
      lo="${span%%..*}"; hi="${span##*..}"
      seq "${lo#"$2-"}" "${hi#"$2-"}" | sed "s/^/$2-/"
    done
    grep -oE "\b$2-[0-9]+" "$1"
  } | sort -u
}

# Arm 1: no pair, no gate. The block is opt-in per repo.
if [[ -f "$DEV" && -f "$TST" ]]; then
  findings=0

  # Arm 2: fail closed on a missing tool. Not running and passing are different.
  if ! command -v uv >/dev/null 2>&1; then
    echo "[pre-push] x uv is not installed - the test-anchor check cannot run, so it is not passing"
    exit 1
  fi

  # The collected node IDs, read once. The probe and arm 4c share this list and the
  # function below it, so the probe exercises the check that runs and not a copy of it.
  COLLECTED="$(mktemp)"
  # `-o addopts=` is load-bearing. The repo sets `-q` there, and a second `-q`
  # collapses collection to a per-file count with no node ID in it, so every
  # anchored row then reads as uncollected and the arm reports nothing true.
  if uv run pytest --collect-only -q -o addopts= >"$COLLECTED" 2>/dev/null; then
    sort -o "$COLLECTED" "$COLLECTED"
    COLLECTED_OK=1
  else
    COLLECTED_OK=0
  fi

  uncollected_rows() {  # $1 = a test plan. Prints every anchored row the runner misses.
    while IFS='|' read -r _ id _ _ _ status node; do
      id="${id// /}"; status="${status// /}"; node="${node//[ |]/}"
      if [ -z "$node" ]; then
        # A blank column used to skip the row, so the one row of 122 with no test
        # node ID was the only one the arm could not see. Only a case with no test
        # yet earns the blank, and the skill requires an ID for every other status.
        [ "$status" = planned ] || echo "$id: no test node ID, and the row is not planned"
        continue
      fi
      # A (ccw) row names a test in another checkout, the same limit arm 4b records for
      # paths. This runner cannot collect it, and reporting it would train the reader to
      # ignore the arm.
      case "$node" in '(ccw)'*) continue ;; esac
      grep -qF "$node" "$COLLECTED" || echo "$node"
    done < <(grep -E '^\| T-[0-9]' "$1")
  }

  orphan_ids() {  # $1 = source doc, $2 = D or T, $3 = the doc that must hold the row
    for id in $(plan_ids "$1" "$2"); do
      grep -qE "^\| $id \|" "$3" || echo "$id"
    done
  }

  dead_paths() {  # $1 = a development plan. Prints every anchored path the tree lacks.
    while IFS= read -r entry; do
      # The skip is per path, never per row. One `(ccw)` token used to match the whole
      # column and silence the check for every in-repo path sharing that row.
      case "$entry" in '('*) continue ;; esac
      [ -n "$(git -C "$REPO_ROOT" ls-files -- "$entry")" ] || echo "$entry"
    done < <(awk -F'|' '/^\| D-[0-9]/ {
      n = split($5, a, ",")
      for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", a[i]); if (a[i] != "") print a[i] }
    }' "$1")
  }

  uncovered_dev_rows() {  # $1 = a development plan. Prints every D row naming no T-nn.
    while IFS='|' read -r _ id _ _ _ cases; do
      case "$cases" in *T-[0-9]*) continue ;; esac
      echo "${id// /}"
    done < <(grep -E '^\| D-[0-9]' "$1")
  }

  uncovered_test_rows() {  # $1 = a test plan. Prints every T row naming no D-nn.
    while IFS='|' read -r _ id _ _ covers _; do
      case "$covers" in *D-[0-9]*) continue ;; esac
      echo "${id// /}"
    done < <(grep -E '^\| T-[0-9]' "$1")
  }

  # Arm 3: the refusal probe. Feed the real checks a document that must fail. Each call
  # here is the function the arm below calls, so a probe that passes proves the shipped
  # check refuses. Re-implementing the pipeline here would only prove awk still works.
  PROBE="$(mktemp -d)"
  {
    printf '| T-99 | probe | S-99 | D-99 | planned | tests/test_nothing.py::test_absent |\n'
    printf '| T-98 | probe | S-99 | none | planned |  |\n'
    printf '| T-97 | probe | S-99 | D-97 | done |  |\n'
  } > "$PROBE/test-plan.md"
  {
    # The path is one the tree does not carry, beside a `(ccw)` token in the same
    # column. Naming a tracked path here would pass a dead-path check that never ran.
    printf '| D-99 | probe | planned | (ccw) elsewhere.go, src/graphrag/no_such_module.py | T-99, T-96 |\n'
    printf '| D-98 | probe | planned | src/graphrag/store.py | none |\n'
  } > "$PROBE/development-plan.md"
  probe_failed() {
    rm -rf "$PROBE"
    echo "[pre-push] x $1"
    echo "[pre-push]   passing and not running are the same observation here"
    exit 1
  }
  # Skipped where collection failed, and arm 4c below reports that as a finding.
  if [ "$COLLECTED_OK" -eq 1 ] && [ -z "$(uncollected_rows "$PROBE/test-plan.md")" ]; then
    probe_failed "the anchor check found nothing wrong with a deliberately broken row"
  fi
  if [ -z "$(uncovered_dev_rows "$PROBE/development-plan.md")" ]; then
    probe_failed "the coverage check accepted a D row that names no case"
  fi
  if [ -z "$(uncovered_test_rows "$PROBE/test-plan.md")" ]; then
    probe_failed "the coverage check accepted a T row that names no development row"
  fi
  if [ -z "$(orphan_ids "$PROBE/test-plan.md" D "$PROBE/development-plan.md")" ]; then
    probe_failed "the orphan check accepted a D-nn the dev plan has no row for"
  fi
  if [ -z "$(orphan_ids "$PROBE/development-plan.md" T "$PROBE/test-plan.md")" ]; then
    probe_failed "the orphan check accepted a T-nn the test plan has no row for"
  fi
  if [ -z "$(dead_paths "$PROBE/development-plan.md")" ]; then
    probe_failed "the dead-path check accepted a path the tree does not carry"
  fi
  rm -rf "$PROBE"

  # Arm 4a: orphan IDs. Every D- in one document resolves to a row in the other.
  while IFS= read -r id; do
    echo "[pre-push] orphan $id: named in the test plan, no row in the dev plan"
    findings=1
  done < <(orphan_ids "$TST" D "$DEV")
  while IFS= read -r id; do
    echo "[pre-push] orphan $id: named in the dev plan, no row in the test plan"
    findings=1
  done < <(orphan_ids "$DEV" T "$TST")

  # Arm 4b: dead paths. A (ccw) path lives in another checkout, so that path is skipped.
  while IFS= read -r p; do
    echo "[pre-push] dead path: $p"
    findings=1
  done < <(dead_paths "$DEV")

  # Arm 4c: uncollected tests. Arm 3 proved this function refuses a broken row.
  if [ "$COLLECTED_OK" -eq 1 ]; then
    while IFS= read -r node; do
      echo "[pre-push] uncollected test: $node"
      findings=1
    done < <(uncollected_rows "$TST")
  else
    echo "[pre-push] pytest collected nothing - every anchored test reads as uncollected"
    findings=1
  fi
  rm -f "$COLLECTED"

  # Arm 4d: coverage. Arm 4a resolves an ID a row names, so a row naming none is invisible
  # to it. Both documents state the rule that every D row names at least one T row.
  while IFS= read -r id; do
    echo "[pre-push] uncovered $id: the dev plan row names no T-nn"
    findings=1
  done < <(uncovered_dev_rows "$DEV")
  while IFS= read -r id; do
    echo "[pre-push] uncovered $id: the test plan row names no D-nn"
    findings=1
  done < <(uncovered_test_rows "$TST")

  if [ "$findings" -ne 0 ]; then
    if [ "$PLAN_GATE_BLOCKING" -eq 1 ]; then
      echo "[pre-push] x the plan pair does not match the tree - push blocked"
      exit 1
    fi
    echo "[pre-push] ! findings above are advisory while the pair is seeded"
  fi
fi

if [[ -d "$REPO_ROOT/knowledge" ]]; then
  if ! command -v okfrules >/dev/null 2>&1; then
    echo "[pre-push] x okfrules not installed - knowledge/ cannot be checked, and this hook is its only local gate"
    echo "[pre-push]   go install github.com/fairyhunter13/okf/cmd/okfrules@v0.6.0"
    exit 1
  fi
  # A hook chmod -x'd in the *index* is planted non-executable in every future clone, and git
  # skips a hook it cannot execute without saying a word.
  HOOK_MODE="$(git -C "$REPO_ROOT" ls-files -s .githooks/pre-push 2>/dev/null | awk '{print $1}')"
  if [ "$HOOK_MODE" != "100755" ]; then
    echo "[pre-push] x .githooks/pre-push is mode '$HOOK_MODE' in the index, want 100755 - every"
    echo "[pre-push]   future clone of this repo would push ungated."
    exit 1
  fi
  OKF_PROBE="$(mktemp -d)"
  printf -- '---\ntitle: no type key\n---\n\nbody\n' > "$OKF_PROBE/broken.md"
  if okfrules check "$OKF_PROBE" >/dev/null 2>&1; then
    rm -rf "$OKF_PROBE"
    echo "[pre-push] x okfrules accepted a concept with no type key - the checker on PATH gates nothing"
    exit 1
  fi
  rm -rf "$OKF_PROBE"
  # -strict, not the fleet default: TimestampsCarryAnOffset is a Strict rule, and an
  # offset-free stale_after reads as fresh forever. This bundle is new and can be born clean.
  if ! okfrules -strict check -Werror "$REPO_ROOT/knowledge"; then
    echo "[pre-push] x knowledge/ is not a conformant OKF bundle - push blocked"
    exit 1
  fi

  # Augment, never shrink. Two things were wrong here and each on its own disabled the arm.
  # The ref was HEAD, and at push time HEAD *is* the tree, so every concept was compared
  # against itself. And a shrink is a warning, so `okf check` exited 0 reporting one.
  if command -v okf >/dev/null 2>&1; then
    # The upstream tip is what the push adds to. A first push has none, so fall back.
    SHRINK_BASE="$(git -C "$REPO_ROOT" rev-parse --verify --quiet '@{upstream}' \
      || git -C "$REPO_ROOT" rev-parse --verify --quiet HEAD~1 || true)"
    if [ -z "$SHRINK_BASE" ]; then
      echo "[pre-push] - no upstream and no parent commit, so there is nothing to shrink against"
    else
      NOSHRINK="$REPO_ROOT/scripts/check_no_shrink.py"
      SHRINK_PROBE="$(mktemp -d)"
      (
        cd "$SHRINK_PROBE" && git init -q . \
          && git -c user.email=probe@probe -c user.name=probe commit -qm root --allow-empty
        mkdir knowledge
        printf -- '---\ntype: Constraint\ntitle: probe\n---\n\n# One\n\nbody\n\n# Two\n\nbody\n' \
          > knowledge/c.md
        git add -A && git -c user.email=probe@probe -c user.name=probe commit -qm one
        printf -- '---\ntype: Constraint\ntitle: probe\n---\n\n# One\n\nbody\n' > knowledge/c.md
        git add -A && git -c user.email=probe@probe -c user.name=probe commit -qm two
      ) >/dev/null 2>&1
      if uv run --project "$REPO_ROOT" python "$NOSHRINK" HEAD~1 "$SHRINK_PROBE/knowledge" \
        >/dev/null 2>&1; then
        rm -rf "$SHRINK_PROBE"
        echo "[pre-push] x the shrink check accepted a concept that lost a heading"
        echo "[pre-push]   passing and not running are the same observation here"
        exit 1
      fi
      rm -rf "$SHRINK_PROBE"
      if ! uv run --project "$REPO_ROOT" python "$NOSHRINK" "$SHRINK_BASE" "$REPO_ROOT/knowledge"; then
        echo "[pre-push] x a concept lost content against $SHRINK_BASE - push blocked"
        exit 1
      fi
    fi
  else
    echo "[pre-push] x okf not installed - the augment-never-shrink rule cannot be checked"
    echo "[pre-push]   go install github.com/fairyhunter13/okf/cmd/okf@v0.6.0"
    exit 1
  fi

  # The receipt-to-attester invariant, which okfrules does not carry. A probe first: a contract
  # naming a missing attester must fail, or passing and not running are the same observation.
  CONTRACT="$REPO_ROOT/scripts/check_attester_contract.py"
  ATTEST_PROBE="$(mktemp -d)"
  printf -- '---\ntype: Attested Computation\ntitle: no attester\nruntime: python\n---\n\nbody\n' \
    > "$ATTEST_PROBE/broken.md"
  if uv run --project "$REPO_ROOT" python "$CONTRACT" "$ATTEST_PROBE" >/dev/null 2>&1; then
    rm -rf "$ATTEST_PROBE"
    echo "[pre-push] x the attester contract check accepted a computation with no attester"
    exit 1
  fi
  rm -rf "$ATTEST_PROBE"
  if ! uv run --project "$REPO_ROOT" python "$CONTRACT" "$REPO_ROOT/knowledge"; then
    echo "[pre-push] x an Attested Computation names an attester that does not read its receipt"
    exit 1
  fi
fi

exit 0
